{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "server.js"
        },
        {
            "src": "/(.*)",
            "dest": "server.js"
        }
    ],
    "env": {
        "JWT_SECRET": "@kodbank-jwt-secret",
        "JWT_EXPIRES_IN": "24h",
        "NODE_ENV": "production"
    }
}